# Copy to .env and replace every placeholder. Never commit the real file.
# For local development, `dev/start.sh` generates dev/.secrets and the
# `npm run dev` script loads it automatically.

# Bearer token required by POST /invites
GATEKEEPER_ADMIN_TOKEN=replace-with-a-long-random-string

# Must equal registration_shared_secret in the Synapse homeserver config
REGISTRATION_SHARED_SECRET=replace-with-a-long-random-string

# Where Synapse listens (client-server API)
SYNAPSE_URL=http://localhost:8008

# Server name the accounts are created on
MATRIX_SERVER_NAME=localhost

# SQLite file holding hashed invite codes
GATEKEEPER_DB=./data/gatekeeper.db

HOST=localhost
PORT=8090

# Comma-separated list of browser origins allowed to call /redeem
CORS_ORIGINS=http://localhost:5173

# Redemption attempts allowed per client address per window
REDEEM_LIMIT=10
REDEEM_WINDOW_SECONDS=900
