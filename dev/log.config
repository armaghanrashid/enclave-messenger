version: 1
formatters:
  precise:
    format: "%(asctime)s - %(name)s - %(lineno)d - %(levelname)s - %(request)s - %(message)s"
handlers:
  console:
    class: logging.StreamHandler
    formatter: precise
filters:
  context:
    (): synapse.util.logcontext.LoggingContextFilter
    request: ""
root:
  level: WARNING
  handlers: [console]
disable_existing_loggers: false
