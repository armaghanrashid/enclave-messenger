# Local development homeserver. Rendered by start.sh into data/homeserver.yaml
# (gitignored); the @@PLACEHOLDERS@@ are filled from .secrets and the local paths.
server_name: "localhost"
pid_file: "@@DATA_DIR@@/homeserver.pid"
signing_key_path: "@@DATA_DIR@@/signing.key"
media_store_path: "@@DATA_DIR@@/media"
log_config: "@@DEV_DIR@@/log.config"
report_stats: false

listeners:
  - port: 8008
    bind_addresses: ["127.0.0.1"]
    type: http
    tls: false
    x_forwarded: false
    resources:
      - names: [client]
        compress: false

database:
  name: sqlite3
  args:
    database: "@@DATA_DIR@@/homeserver.db"

# Accounts are created only through the gatekeeper, which signs requests with
# the shared secret. Open registration stays off.
enable_registration: false
registration_shared_secret: "@@REGISTRATION_SHARED_SECRET@@"
allow_guest_access: false

macaroon_secret_key: "@@MACAROON_SECRET_KEY@@"
form_secret: "@@FORM_SECRET@@"

# Single-server development setup: no federation, no key servers, no presence.
federation_domain_whitelist: []
trusted_key_servers: []
suppress_key_server_warning: true
enable_media_repo: false
presence:
  enabled: false

# Generous limits so the seed script and browser tests are never throttled.
rc_message:
  per_second: 100
  burst_count: 1000
rc_registration:
  per_second: 10
  burst_count: 100
rc_login:
  address:
    per_second: 10
    burst_count: 100
  account:
    per_second: 10
    burst_count: 100
  failed_attempts:
    per_second: 10
    burst_count: 100
rc_joins:
  local:
    per_second: 10
    burst_count: 100
rc_invites:
  per_room:
    per_second: 10
    burst_count: 100
  per_user:
    per_second: 10
    burst_count: 100
